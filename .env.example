# Copy this file to .env and adjust only the values you need.

# Yubico's USB vendor ID. Keep this unless you know you need a different vendor.
YUBIWATCH_VENDOR_ID=0x1050

# Original detected key for this laptop: VID 0x1050 / PID 0x0402.
# Leave blank only if you intentionally want to accept any Yubico USB product ID.
YUBIWATCH_PRODUCT_IDS=0x0402

# Laptop-friendly polling. Present checks are slower to save CPU; missing checks are faster.
YUBIWATCH_PRESENT_POLL_SECONDS=2.0
YUBIWATCH_MISSING_POLL_SECONDS=0.5
YUBIWATCH_MISSING_GRACE_SECONDS=2.0
YUBIWATCH_POST_LOCK_POLL_SECONDS=2.0
YUBIWATCH_RELOCK_SECONDS=5.0
YUBIWATCH_STARTUP_GRACE_SECONDS=5.0

# Security posture. When true, detector errors are treated as "key absent".
YUBIWATCH_FAIL_SAFE_LOCK=true

# Startup policy. Keep false unless you explicitly want protection to start enabled.
YUBIWATCH_ALWAYS_KEEP_ENABLED=false
YUBIWATCH_LOCK_ENABLED=false

# Native Rust dashboard. Protection changes require the configured key and PIN.
YUBIWATCH_DASHBOARD_ENABLED=true
YUBIWATCH_DASHBOARD_PORT=8765
YUBIWATCH_OPEN_DASHBOARD_ON_STARTUP=true

# Leave blank for %LOCALAPPDATA%\YubiWatch\pin.dat.
# The file stores a salted verifier, not the plaintext Security PIN.
YUBIWATCH_PIN_FILE=

# Protected Mode. Defaults are safe: deep OS modules start disabled until a service backend exists.
YUBIWATCH_SECURE_MODE_ENABLED=false
YUBIWATCH_MODULE_IDENTITY_ACCESS=true
YUBIWATCH_MODULE_DEVICE_CONTROL=false
YUBIWATCH_MODULE_NETWORK_SECURITY=false
YUBIWATCH_MODULE_APPLICATION_CONTROL=false
YUBIWATCH_MODULE_DATA_PROTECTION=false
YUBIWATCH_MODULE_CLIPBOARD_TRANSFER=false
YUBIWATCH_MODULE_SESSION_PROTECTION=true
YUBIWATCH_MODULE_TAMPER_DETECTION=false
YUBIWATCH_MODULE_AUDIT_LOGGING=true
YUBIWATCH_MODULE_COMPLIANCE_MONITORING=true

# Leave blank for %LOCALAPPDATA%\YubiWatch\audit.jsonl.
YUBIWATCH_AUDIT_LOG_FILE=
YUBIWATCH_AUDIT_MAX_BYTES=1048576
YUBIWATCH_DISABLE_PROOF_TIMEOUT_SECONDS=45

# Python fallback only. The Rust native executable uses Windows SetupAPI instead of libusb.
YUBIWATCH_LIBUSB_DLL=

# Python fallback only. The Rust native executable does not write logs.
# Example if troubleshooting: C:\Users\kunmi\Downloads\YubiWatch\logs\yubiwatch.log
YUBIWATCH_LOG_FILE=
YUBIWATCH_LOG_LEVEL=INFO
YUBIWATCH_CONSOLE_LOG=false
YUBIWATCH_MAX_LOG_BYTES=262144
YUBIWATCH_LOG_BACKUP_COUNT=2
